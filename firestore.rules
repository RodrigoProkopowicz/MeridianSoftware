rules_version = '2';

// Meridian Software — Firestore Security Rules
//
// Collections:
//   users/{uid}               — user profile owned by that uid
//   demoRequests/{id}         — created by authenticated user; immutable after create
//   contactSubmissions/{id}   — created by anyone (anonymous contact form); read by admin only
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function payloadSizeOK() {
      // Limita por cantidad de campos (request.resource.size no existe en
      // Firestore rules — solo aplica a Storage). 30 campos es generoso para
      // los docs de esta app y previene payloads abusivos.
      return request.resource.data.size() < 30;
    }

    function hasOnlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isNonEmptyString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // ---- users/{uid} ----
    // Profile is created and maintained by AuthenticationService.createOrUpdateUserProfile
    match /users/{uid} {
      allow read:   if isOwner(uid);
      allow create: if isOwner(uid)
                       && hasOnlyFields(['email','displayName','photoURL','provider','createdAt','lastLoginAt'])
                       && payloadSizeOK();
      allow update: if isOwner(uid)
                       && request.resource.data.keys().hasOnly(['email','displayName','photoURL','provider','createdAt','lastLoginAt'])
                       && payloadSizeOK();
      allow delete: if false;
    }

    // ---- demoRequests/{id} ----
    // Any signed-in user can create a request for themselves; not readable/editable from the client.
    // Admin access is handled server-side (Firebase Console or Admin SDK).
    match /demoRequests/{id} {
      allow read:   if false;
      allow create: if isSignedIn()
                       && request.resource.data.userId == request.auth.uid
                       && hasOnlyFields(['userId','solutionType','companyName','message','preferredDate','status','recaptchaToken','createdAt'])
                       && isNonEmptyString(request.resource.data.solutionType, 100)
                       && isNonEmptyString(request.resource.data.companyName, 200)
                       && request.resource.data.status == 'pending'
                       && payloadSizeOK();
      allow update, delete: if false;
    }

    // ---- contactSubmissions/{id} ----
    // Open to anonymous creation (contact form); not readable from client.
    match /contactSubmissions/{id} {
      allow read:   if false;
      allow create: if hasOnlyFields(['name','email','company','message','status','recaptchaToken','createdAt'])
                       && isNonEmptyString(request.resource.data.name, 200)
                       && isNonEmptyString(request.resource.data.email, 200)
                       && isNonEmptyString(request.resource.data.message, 5000)
                       && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                       && request.resource.data.status == 'new'
                       && payloadSizeOK();
      allow update, delete: if false;
    }

    // ============================================================
    // Stock Manager — businesses + subcollections
    // Used by /stock-manager (separate Vite app, same Firebase project).
    // No usamos payloadSizeOK() porque depende de request.resource.size,
    // que no existe en Firestore rules (solo aplica a Storage). En su lugar
    // limitamos por número de campos con request.resource.data.size().
    // ============================================================

    function businessOwner(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
    }

    match /businesses/{businessId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isSignedIn()
                       && request.resource.data.ownerId == request.auth.uid
                       && request.resource.data.keys().hasOnly(['ownerId','name','currency','createdAt','updatedAt'])
                       && isNonEmptyString(request.resource.data.name, 120)
                       && isNonEmptyString(request.resource.data.currency, 8);
      allow update: if isOwner(resource.data.ownerId)
                       && request.resource.data.ownerId == resource.data.ownerId
                       && request.resource.data.size() < 30;
      allow delete: if isOwner(resource.data.ownerId);

      // ---- products ----
      match /products/{productId} {
        allow read:   if isOwner(businessOwner(businessId));
        allow create: if isOwner(businessOwner(businessId))
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if isOwner(businessOwner(businessId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(businessOwner(businessId));
      }

      // ---- movements ----
      // Inmutables: solo create + read.
      match /movements/{movementId} {
        allow read:   if isOwner(businessOwner(businessId));
        allow create: if isOwner(businessOwner(businessId))
                         && request.resource.data.userId == request.auth.uid
                         && request.resource.data.size() < 30;
        allow update, delete: if false;
      }

      // ---- suppliers ----
      match /suppliers/{supplierId} {
        allow read:   if isOwner(businessOwner(businessId));
        allow create: if isOwner(businessOwner(businessId))
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if isOwner(businessOwner(businessId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(businessOwner(businessId));
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

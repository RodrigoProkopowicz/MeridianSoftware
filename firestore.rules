rules_version = '2';

// Meridian Software — Firestore Security Rules
//
// Collections:
//   users/{uid}               — perfil del usuario; las cuentas las crea un admin (callable createUser)
//   demoRequests/{id}         — pedido de prueba del formulario público (sin login); lo lee el admin
//   contactSubmissions/{id}   — created by anyone (anonymous contact form); read by admin only
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function payloadSizeOK() {
      // Limita por cantidad de campos (request.resource.size no existe en
      // Firestore rules — solo aplica a Storage). 30 campos es generoso para
      // los docs de esta app y previene payloads abusivos.
      return request.resource.data.size() < 30;
    }

    function hasOnlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isNonEmptyString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Super-admin global. Fuente de verdad ÚNICA: el custom claim
    // `auth.token.admin == true` (seteado por la callable `setAdminClaim` o por
    // el script grant-first-admin.mjs).
    //
    // Antes también se aceptaba `users/{uid}.role == 'admin'`; se unificó en el
    // claim porque el resto del sistema (callables + panel) solo confía en el
    // claim, así que un admin "role-only" quedaba a medias. ⚠️ ANTES de deployar
    // esta versión, correr `functions/scripts/migrate-admin-to-claim.mjs` para
    // otorgarle el claim a cualquier admin que hoy sea solo por role — si no,
    // pierde el acceso a Firestore. Bonus: sin el get() de antes, isAdmin() ya
    // no cuesta una lectura por chequeo.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---- users/{uid} ----
    // Profile is created and maintained by AuthenticationService.createOrUpdateUserProfile.
    // Admins can read/list all profiles for the admin panel.
    match /users/{uid} {
      allow read, list: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                       && hasOnlyFields(['email','displayName','photoURL','provider','createdAt','lastLoginAt'])
                       && payloadSizeOK();
      // Owner puede actualizar los campos originales sin tocar `role`, `admin`,
      // `accountType` ni `employerUid` (los mantiene como estaban o ausentes).
      // Admin puede modificarlos todos.
      //   - `admin` lo escribe la callable createUser/setAdminClaim (Admin SDK)
      //     para que el panel sepa quién es admin.
      //   - `accountType` distingue la cuenta dueña (la que crea el panel) de
      //     las de empleado (las crea createBusinessMember). Que el propio
      //     usuario pudiera cambiarlo sería ascenderse solo: por eso es inmutable
      //     para él y solo lo escribe el Admin SDK.
      allow update: if (isOwner(uid)
                         && request.resource.data.keys().hasOnly(['email','displayName','photoURL','provider','createdAt','lastLoginAt','role','admin','accountType','employerUid'])
                         && request.resource.data.get('role', null) == resource.data.get('role', null)
                         && request.resource.data.get('admin', null) == resource.data.get('admin', null)
                         && request.resource.data.get('accountType', null) == resource.data.get('accountType', null)
                         && request.resource.data.get('employerUid', null) == resource.data.get('employerUid', null)
                         && payloadSizeOK())
                      || (isAdmin()
                           && request.resource.data.keys().hasOnly(['email','displayName','photoURL','provider','createdAt','lastLoginAt','role','admin','accountType','employerUid']));
      allow delete: if false;

      // ---- users/{uid}/demoAccess/{productId} ----
      // Demo grants for in-house products (stock-manager, medicus). Ya NO hay
      // auto-servicio: el visitante pide la prueba por el formulario público y
      // un admin la otorga desde el panel /admin (o la callable createUser).
      // Por eso create/update/delete son admin-only; el owner solo lee su estado.
      match /demoAccess/{productId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow list:   if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- demoRequests/{id} ----
    // Pedidos de prueba del formulario PÚBLICO (sin login): cualquiera puede
    // crear uno con sus datos de contacto. App Check + la validación reCAPTCHA
    // server-side (validateDemoRecaptcha) filtran spam. El admin lee/lista y
    // puede actualizar solo status + adminNotes desde el panel.
    match /demoRequests/{id} {
      allow read, list: if isAdmin();
      allow create: if hasOnlyFields(['name','email','companyName','solutionType','message','status','recaptchaToken','createdAt'])
                       && isNonEmptyString(request.resource.data.name, 200)
                       && isNonEmptyString(request.resource.data.email, 200)
                       && isNonEmptyString(request.resource.data.solutionType, 100)
                       && request.resource.data.status == 'pending'
                       && payloadSizeOK();
      allow update: if isAdmin()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNotes']);
      allow delete: if false;
    }

    // ---- contactSubmissions/{id} ----
    // El formulario de contacto pasó a usar mailto: del lado del cliente.
    // Ya no recibimos submissions nuevas; el admin puede leer el historial
    // que quedó, pero create/update/delete siguen cerrados.
    match /contactSubmissions/{id} {
      allow read, list: if isAdmin();
      allow write:      if false;
    }

    // ---- promotionalSubscriptions/{id} ----
    // Suscripciones del módulo /promo (PromotionalSection). El documento lo crea
    // y actualiza la Cloud Function `createPromotionalPreapproval` / el webhook
    // de Mercado Pago vía Admin SDK (bypassea estas reglas), por eso el cliente
    // NO puede crear: así el access token de MP y el estado de pago quedan solo
    // del lado del servidor. El admin lee todo y solo puede editar el estado del
    // trabajo y sus notas — nunca los campos de pago, que se sincronizan server-side.
    match /promotionalSubscriptions/{id} {
      allow read, list: if isAdmin();
      allow create:     if false;
      allow update:     if isAdmin()
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['workStatus', 'adminNotes', 'updatedAt']);
      // El admin puede borrar solo registros con error o cancelados (limpieza
      // de "logs"); nunca activas/pendientes/pausadas, que tienen una sub viva en MP.
      allow delete:     if isAdmin()
                           && resource.data.paymentStatus in ['error', 'cancelled'];
    }

    // ============================================================
    // Stock Manager — businesses + subcollections
    // Used by /stock-manager (separate Vite app, same Firebase project).
    // No usamos payloadSizeOK() porque depende de request.resource.size,
    // que no existe en Firestore rules (solo aplica a Storage). En su lugar
    // limitamos por número de campos con request.resource.data.size().
    // ============================================================

    function businessOwner(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
    }

    // ---- Equipo del comercio ----
    // Modelo de cuentas de Stock Manager:
    //   - El DUEÑO (`businesses/{id}.ownerId`) es la cuenta que crea el panel de
    //     Meridian. Manda en sus comercios y no necesita doc de miembro.
    //   - Los EMPLEADOS viven en `businesses/{id}/members/{uid}` con su rol y su
    //     mapa de permisos. Los crea la callable `createBusinessMember`.
    //
    // Estas reglas son el respaldo real de los permisos: la UI esconde lo que
    // la persona no puede hacer, pero lo que lo impide de verdad es esto.
    function memberData(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data;
    }

    function isActiveMember(businessId) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
             && memberData(businessId).get('active', true) == true;
    }

    // Un empleado con rol admin equivale al dueño puertas adentro del comercio.
    function memberCan(businessId, permission) {
      return isActiveMember(businessId)
             && (memberData(businessId).get('role', 'custom') == 'admin'
                 || memberData(businessId).get('permissions', {}).get(permission, false) == true);
    }

    // La pregunta que hace cada colección: ¿esta persona puede esto, acá?
    function can(businessId, permission) {
      return isOwner(businessOwner(businessId)) || memberCan(businessId, permission) || isAdmin();
    }

    // ¿Administra el comercio? Dueño, empleado activo con rol admin o super-admin.
    // `memberCan` no sirve para esto: acepta un permiso suelto, y lo que se
    // pregunta acá es justo lo que ningún tilde tiene que poder otorgar.
    function isBusinessAdmin(businessId) {
      return isOwner(businessOwner(businessId))
             || (isActiveMember(businessId)
                 && memberData(businessId).get('role', 'custom') == 'admin')
             || isAdmin();
    }

    // Quién puede mover la CANTIDAD de un producto (y solo la cantidad):
    //   - el depósito, cargando un movimiento a mano;
    //   - la venta, al emitir una factura o un remito — descuenta el stock y deja
    //     el movimiento en la MISMA transacción que el comprobante;
    //   - la anulación con reversión, que hace el camino inverso.
    //
    // Si esas escrituras exigieran `stock.manage`, ni el rol Ventas podría
    // facturar ni un empleado de depósito sin permiso de editar productos podría
    // registrar una entrada: en una transacción, una sola operación denegada
    // tumba todo. Editar precios, nombres o mínimos sigue siendo `stock.manage`.
    //
    // No se resuelve llamando `can()` cuatro veces para no multiplicar accesos a
    // documentos dentro de la evaluación: así toca los mismos dos docs que el resto.
    function movesStock(businessId) {
      return isOwner(businessOwner(businessId))
             || isAdmin()
             || (isActiveMember(businessId)
                 && (memberData(businessId).get('role', 'custom') == 'admin'
                     || memberData(businessId).get('permissions', {}).get('movements.create', false) == true
                     || memberData(businessId).get('permissions', {}).get('invoices.create', false) == true
                     || memberData(businessId).get('permissions', {}).get('remitos.create', false) == true
                     || memberData(businessId).get('permissions', {}).get('invoices.cancel', false) == true));
    }

    // Cualquiera que trabaje en el comercio (para lo transversal: numeración).
    function belongsToBusiness(businessId) {
      return isOwner(businessOwner(businessId)) || isActiveMember(businessId) || isAdmin();
    }

    // Las cuentas de empleado no crean comercios propios: los suyos son los que
    // les asigna su administrador.
    function isEmployeeAccount() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', 'owner') == 'employee';
    }

    // ---- Comprobantes: lo emitido no se reescribe ----
    // Facturas, remitos, recibos y devoluciones no se editan: quien tiene
    // "Anular comprobantes" escribe la anulación y nada más. Lo demás queda como
    // se emitió:
    //   - número, cliente, renglones e importes;
    //   - lo cobrado al emitir (`payment`, que mueve la cuenta corriente);
    //   - la fecha, que define el período de las comisiones;
    //   - el CAE, que lo escribe ARCA desde el servidor;
    //   - la firma: `userId`, el nombre que quedó al lado (`userName`) e
    //     `imported` (lo trajo un backup y no es venta de nadie) dicen de quién
    //     es cada venta en "Ventas por vendedor".
    //
    // Se anula una sola vez, no se des-anula y queda con la hora del servidor.
    // `cancelledBy` es el uid de quien anula; puede faltar porque el hosting
    // viejo anula sin firmar. Una escritura que no anula solo toca `updatedAt`.
    //
    // `stockFields`: lo que esa anulación escribe además al devolver el stock.
    function writesOnlyCancellation(stockFields) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let cancelFields = ['status', 'cancelReason', 'cancelledAt', 'cancelledBy'].concat(stockFields);
      let cancelling = resource.data.get('status', null) != 'cancelled'
                       && request.resource.data.get('status', null) == 'cancelled';
      return changed.hasOnly(cancelFields.concat(['updatedAt']))
             && (cancelling || !changed.hasAny(cancelFields))
             && (!('cancelledAt' in changed) || request.resource.data.cancelledAt == request.time)
             && (!('cancelledBy' in changed) || request.resource.data.cancelledBy == request.auth.uid);
    }

    // Al emitir, la firma es de quien escribe: cada `create` exige su `userId`,
    // y el comprobante tampoco puede nacer anulado en nombre de otro.
    function cancelledBySigner() {
      return request.resource.data.get('cancelledBy', request.auth.uid) == request.auth.uid;
    }

    match /businesses/{businessId} {
      // Lo ven su dueño y su equipo (el empleado necesita leer el comercio para
      // saber su nombre y su moneda).
      allow read:   if isOwner(resource.data.ownerId) || isActiveMember(businessId) || isAdmin();
      allow create: if (isSignedIn()
                         && !isEmployeeAccount()
                         && request.resource.data.ownerId == request.auth.uid
                         && request.resource.data.keys().hasOnly(['ownerId','name','currency','createdAt','updatedAt'])
                         && isNonEmptyString(request.resource.data.name, 120)
                         && isNonEmptyString(request.resource.data.currency, 8))
                      || isAdmin();
      // El dueño no se puede transferir: `ownerId` es inmutable.
      allow update: if ((isOwner(resource.data.ownerId) || memberCan(businessId, 'business.manage'))
                         && request.resource.data.ownerId == resource.data.ownerId
                         && request.resource.data.size() < 30)
                      || isAdmin();
      // Borrar el comercio es del dueño y de nadie más.
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      // ---- members (equipo del comercio) ----
      // La cuenta la crea la callable `createBusinessMember` y `assignBusinessMember`
      // la suma a otro comercio del mismo dueño (Admin SDK, se saltean estas
      // reglas). Desde el cliente solo se editan rol y permisos.
      match /members/{memberId} {
        // Cada quien lee su propia membresía (así la app sabe qué puede hacer);
        // el dueño y quien administra el equipo leen todo el listado, y quien
        // asigna controles de stock también: elegir quién cuenta es su permiso.
        allow read, list: if isSignedIn()
                             && (memberId == request.auth.uid
                                 || isOwner(businessOwner(businessId))
                                 || memberCan(businessId, 'team.manage')
                                 || memberCan(businessId, 'stockcount.manage')
                                 || isAdmin());
        // El único create desde el cliente es el del propio dueño al crear el
        // comercio (queda listado en Equipo). Los empleados los crea la callable.
        allow create: if (isOwner(businessOwner(businessId)) && memberId == request.auth.uid)
                         || isAdmin();
        // Nadie edita su propia membresía: si no, quien administra el equipo se
        // ascendería a admin de un tilde. El uid tampoco se puede reapuntar, ni
        // el comercio: la app arma la lista de comercios desde ese campo, y un
        // doc que apunte a otro lado deja al empleado sin poder entrar a ninguno.
        //
        // A un admin lo toca solo otro admin. `team.manage` es un tilde y el rol
        // admin es lo que ningún tilde otorga: da el registro y saca de él. Por
        // eso la condición mira los dos lados: si solo mirara lo que queda
        // escrito, ese tilde podría desactivar o reactivar a un admin.
        allow update: if ((isOwner(businessOwner(businessId))
                            || (memberCan(businessId, 'team.manage') && memberId != request.auth.uid))
                           && request.resource.data.uid == resource.data.uid
                           && request.resource.data.get('businessId', businessId) == businessId
                           && request.resource.data.size() < 15
                           && ((request.resource.data.get('role', 'custom') != 'admin'
                                && resource.data.get('role', 'custom') != 'admin')
                               || isBusinessAdmin(businessId)))
                        || isAdmin();
        allow delete: if isOwner(businessOwner(businessId)) || isAdmin();
      }

      // ---- products ----
      match /products/{productId} {
        // El catálogo es de `stock.view`. Pero anular, devolver o facturar leen
        // cada producto por id dentro de la transacción, y una sola lectura
        // denegada tumba todo: quien mueve stock necesita esa lectura aunque no
        // vea el catálogo. Por eso van separados: `get` abre el doc que ya se
        // conoce y `list` sigue cerrado.
        allow get:    if can(businessId, 'stock.view') || movesStock(businessId);
        allow list:   if can(businessId, 'stock.view');
        allow create: if can(businessId, 'stock.manage')
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        // Editar el producto es de `stock.manage`. Quien mueve stock (depósito o
        // venta) solo puede tocar la cantidad, y nada más.
        allow update: if (can(businessId, 'stock.manage')
                           && request.resource.data.size() < 30)
                        || (movesStock(businessId)
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['quantity', 'updatedAt']));
        allow delete: if can(businessId, 'stock.delete');
      }

      // ---- promotions (artículo compuesto: combo, oferta 3x) ----
      // Se leen con `stock.view` porque el vendedor tiene que poder elegirlas
      // al emitir, y se administran con `stock.manage` como cualquier artículo.
      // No guardan stock: el disponible se calcula contra los products.
      match /promotions/{promotionId} {
        allow read:   if can(businessId, 'stock.view');
        allow create: if can(businessId, 'stock.manage')
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 20;
        allow update: if can(businessId, 'stock.manage')
                         && request.resource.data.size() < 20;
        allow delete: if can(businessId, 'stock.manage');
      }

      // ---- movements ----
      // Inmutables para el comercio (solo create + read). Admin tiene bypass
      // para soporte: puede update/delete movements de comercios ajenos.
      // `userId == request.auth.uid` deja firmado quién lo cargó, empleado o dueño.
      match /movements/{movementId} {
        allow read:   if can(businessId, 'stock.view');
        // Los carga el depósito a mano, y también la venta al emitir o anular.
        allow create: if movesStock(businessId)
                         && request.resource.data.userId == request.auth.uid
                         && request.resource.data.size() < 30;
        allow update, delete: if isAdmin();
      }

      // ---- stockCounts (planillas de control de stock) ----
      // El control lo arma quien administra los recuentos y lo completa quien
      // lo tiene asignado, que es la única planilla que puede tocar. La hoja no
      // guarda plata: son artículos, lo que el sistema dice tener y lo contado.
      //
      // Aplicar las diferencias no se escribe acá: son movimientos de ajuste,
      // y los cubre `movesStock()` como cualquier otro movimiento a mano.
      match /stockCounts/{countId} {
        allow read:   if can(businessId, 'stockcount.perform');
        allow create: if can(businessId, 'stockcount.manage')
                         && isNonEmptyString(request.resource.data.title, 120)
                         && isNonEmptyString(request.resource.data.assignedTo, 128)
                         && request.resource.data.size() < 30;
        // Quien cuenta no se puede reasignar la planilla ni pasársela a otro.
        allow update: if (can(businessId, 'stockcount.manage')
                          || (can(businessId, 'stockcount.perform')
                              && resource.data.assignedTo == request.auth.uid
                              && request.resource.data.assignedTo == resource.data.assignedTo))
                         && request.resource.data.size() < 30;
        allow delete: if can(businessId, 'stockcount.manage');
      }

      // ---- tasks (tareas que se le asignan a un empleado) ----
      // Cuelgan del comercio: la misma persona tiene tareas independientes en
      // cada local. Las reparte quien administra el equipo. El asignado no
      // necesita ningún permiso tildado, pero solo ve las suyas y lo único que
      // puede hacer es marcarlas: no se las reescribe ni se las pasa a otro.
      match /tasks/{taskId} {
        // La condición compara `assignedTo`, así que la query del empleado tiene
        // que filtrar por su uid: es lo que le impide listar las de los demás.
        allow read:   if can(businessId, 'team.manage')
                         || (isActiveMember(businessId)
                             && resource.data.assignedTo == request.auth.uid);
        allow create: if can(businessId, 'team.manage')
                         && isNonEmptyString(request.resource.data.title, 200)
                         && isNonEmptyString(request.resource.data.assignedTo, 128)
                         && request.resource.data.size() < 20;
        allow update: if (can(businessId, 'team.manage')
                           && request.resource.data.size() < 20)
                        || (isActiveMember(businessId)
                            && resource.data.assignedTo == request.auth.uid
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['status', 'completedAt', 'completedBy', 'updatedAt']));
        allow delete: if can(businessId, 'team.manage');
      }

      // ---- suppliers ----
      match /suppliers/{supplierId} {
        allow read:   if can(businessId, 'suppliers.view');
        allow create: if can(businessId, 'suppliers.manage')
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if can(businessId, 'suppliers.manage')
                         && request.resource.data.size() < 30;
        allow delete: if can(businessId, 'suppliers.manage');
      }

      // ---- priceLists (listas por cliente: mayorista, distribuidor…) ----
      // Las lee cualquiera que venda (el formulario aplica el ajuste al elegir
      // el cliente) y las administra quien configura el comercio: cambiar una
      // lista cambia lo que se le cobra a todo un grupo de clientes.
      match /priceLists/{listId} {
        allow read:   if can(businessId, 'sales.view') || can(businessId, 'stock.view');
        allow create: if can(businessId, 'business.manage')
                         && isNonEmptyString(request.resource.data.name, 80)
                         && request.resource.data.size() < 15;
        allow update: if can(businessId, 'business.manage')
                         && request.resource.data.size() < 15;
        allow delete: if can(businessId, 'business.manage');
      }

      // ---- clients (destinatarios de facturas) ----
      match /clients/{clientId} {
        allow read:   if can(businessId, 'clients.view');
        allow create: if can(businessId, 'clients.manage')
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if can(businessId, 'clients.manage')
                         && request.resource.data.size() < 30;
        allow delete: if can(businessId, 'clients.manage');
      }

      // ---- invoices (comprobantes de venta) ----
      // Las facturas no se editan: solo se anulan (ver `writesOnlyCancellation`).
      // Emitir y anular son dos permisos distintos: un vendedor factura, pero
      // anular puede quedar reservado. Admin tiene bypass total para soporte
      // (incluido delete).
      match /invoices/{invoiceId} {
        allow read:   if can(businessId, 'sales.view');
        allow create: if can(businessId, 'invoices.create')
                         && request.resource.data.userId == request.auth.uid
                         && cancelledBySigner()
                         && request.resource.data.size() < 40;
        allow update: if (can(businessId, 'invoices.cancel')
                           && request.resource.data.size() < 40
                           && writesOnlyCancellation(['stockReversed', 'reversalMovementIds']))
                        || isAdmin();
        allow delete: if isAdmin();
      }

      // ---- remitos (comprobantes de entrega de mercadería) ----
      // Mismo criterio que invoices: se anulan, no se editan. Admin tiene
      // bypass total.
      match /remitos/{remitoId} {
        allow read:   if can(businessId, 'sales.view');
        allow create: if can(businessId, 'remitos.create')
                         && request.resource.data.userId == request.auth.uid
                         && cancelledBySigner()
                         && request.resource.data.size() < 40;
        allow update: if (can(businessId, 'invoices.cancel')
                           && request.resource.data.size() < 40
                           && (writesOnlyCancellation(['stockReversed', 'reversalMovementIds'])
                               // Anular la factura libera los remitos que cubría.
                               || (request.resource.data.diff(resource.data)
                                     .affectedKeys().hasOnly(['invoiceId', 'updatedAt'])
                                   && request.resource.data.get('invoiceId', null) == null)))
                        // Marcarlo como facturado va en la transacción de emitir
                        // la factura: si exigiera `invoices.cancel`, un vendedor
                        // sin ese permiso no podría facturar un remito.
                        || (can(businessId, 'invoices.create')
                            && resource.data.get('invoiceId', null) == null
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['invoiceId', 'updatedAt']))
                        || isAdmin();
        allow delete: if isAdmin();
      }

      // ---- receipts (recibos: cobros sobre la cuenta corriente) ----
      // Mismo criterio que remitos: se anulan, no se editan (el saldo del
      // cliente se calcula desde estos docs y no puede reescribirse la historia).
      match /receipts/{receiptId} {
        allow read:   if can(businessId, 'accounts.view');
        allow create: if can(businessId, 'receipts.create')
                         && request.resource.data.userId == request.auth.uid
                         && cancelledBySigner()
                         && request.resource.data.size() < 30;
        allow update: if (can(businessId, 'invoices.cancel')
                           && request.resource.data.size() < 30
                           && writesOnlyCancellation([]))
                        || isAdmin();
        allow delete: if isAdmin();
      }

      // ---- creditNotes (devoluciones) ----
      // Una nota de crédito es el "deshacer parcial" de una venta: devuelve
      // parte de lo vendido, acredita en la cuenta del cliente y puede
      // reingresar stock. Por eso la emite quien puede anular comprobantes, y
      // el reingreso lo cubre `movesStock()` (que ya incluye `invoices.cancel`).
      match /creditNotes/{noteId} {
        allow read:   if can(businessId, 'sales.view');
        allow create: if can(businessId, 'invoices.cancel')
                         && request.resource.data.userId == request.auth.uid
                         && cancelledBySigner()
                         && request.resource.data.sourceId is string
                         && request.resource.data.size() < 30;
        // Solo se anula, como el resto de los comprobantes.
        allow update: if (can(businessId, 'invoices.cancel')
                           && request.resource.data.size() < 30
                           && writesOnlyCancellation([]))
                        || isAdmin();
        allow delete: if isAdmin();
      }

      // ---- counters (numeración de comprobantes) ----
      // La numeración es transversal: la toca cualquiera que pueda emitir algo.
      match /counters/{counterId} {
        allow read:           if belongsToBusiness(businessId);
        allow create, update: if (can(businessId, 'invoices.create')
                                  || can(businessId, 'remitos.create')
                                  || can(businessId, 'receipts.create')
                                  || can(businessId, 'invoices.cancel'))
                                  && request.resource.data.size() < 10;
        allow delete:         if isAdmin();
      }

      // ---- activity (registro de lo que hacen los trabajadores) ----
      // Contesta "¿quién hizo esto?": por eso lo lee solo quien administra el
      // comercio y nadie lo reescribe, ni el dueño ni el super-admin.
      //
      // Crear no exige un permiso por acción: la entrada va en la misma
      // transacción que lo que registra, y una sola operación denegada tumbaría
      // la venta entera. `actorId` y `createdAt` no se pueden falsear: la firma
      // es de quien escribe y la hora, la del servidor.
      match /activity/{entryId} {
        allow read:   if isBusinessAdmin(businessId);
        allow create: if belongsToBusiness(businessId)
                         && request.resource.data.actorId == request.auth.uid
                         && request.resource.data.createdAt == request.time
                         && request.resource.data.keys().hasOnly(['action', 'actorId', 'actorName', 'actorRole', 'targetId', 'targetLabel', 'detail', 'createdAt'])
                         && isNonEmptyString(request.resource.data.action, 40);
        allow update, delete: if false;
      }

      // ---- secrets (AFIP cert/key/tokens) ----
      // SOLO accesible vía Cloud Functions (admin SDK bypassea reglas).
      // El cliente NUNCA debe leer ni escribir esto directamente, ni siquiera
      // el super-admin global — usar las callables `saveAfipConfig`, etc.
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    // ---- members (collection group) ----
    // Un empleado no puede listar `businesses` (no es dueño de ninguno): la
    // única forma de descubrir a qué comercios entra es esta query por su uid.
    // Solo devuelve sus propias membresías, nunca las de otros.
    match /{path=**}/members/{memberId} {
      allow read, list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ============================================================
    // Medicus — clinics + subcolecciones
    // Usado por /medicus (Vite app aparte, mismo proyecto Firebase).
    // Modelo:
    //   clinics/{clinicId}                                   ← ownerId = uid
    //     └─ patients/{patientId}
    //         └─ visits/{visitId}                            ← ficha clínica
    //     └─ appointments/{appointmentId}                    ← turnos
    //     └─ transactions/{transactionId}                    ← finanzas
    // ============================================================

    function clinicOwner(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerId;
    }

    match /clinics/{clinicId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isSignedIn()
                       && request.resource.data.ownerId == request.auth.uid
                       && isNonEmptyString(request.resource.data.name, 120)
                       && request.resource.data.size() < 30;
      allow update: if isOwner(resource.data.ownerId)
                       && request.resource.data.ownerId == resource.data.ownerId
                       && request.resource.data.size() < 30;
      allow delete: if isOwner(resource.data.ownerId);

      // ---- patients (HC — protegidos por Ley 26.529) ----
      // Inmutabilidad parcial:
      //  - Hard delete prohibido — usar soft delete vía update (deletedAt).
      //  - createdBy/createdAt no se pueden alterar una vez seteados (la app
      //    se los pone en create; docs viejos pueden no tenerlos y la regla
      //    deja que el migrador los rellene).
      //  - revisionCount monótono — solo se mantiene o crece de a uno.
      //  - El snapshot del estado previo se escribe en subcolección
      //    `revisions/{revId}` (inmutable, ver match más abajo).
      match /patients/{patientId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && isNonEmptyString(request.resource.data.firstName, 80)
                         && isNonEmptyString(request.resource.data.lastName, 80)
                         && request.resource.data.size() < 40;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 40
                         && (!('createdBy' in resource.data)
                             || request.resource.data.createdBy == resource.data.createdBy)
                         && (!('createdAt' in resource.data)
                             || request.resource.data.createdAt == resource.data.createdAt)
                         && (!('revisionCount' in resource.data)
                             || request.resource.data.revisionCount == resource.data.revisionCount
                             || request.resource.data.revisionCount == resource.data.revisionCount + 1);
        // Hard delete prohibido. Usar soft delete (update con deletedAt).
        allow delete: if false;

        // ---- patient revisions (inmutables) ----
        match /revisions/{revId} {
          allow read:   if isOwner(clinicOwner(clinicId));
          allow create: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.revisedBy == request.auth.uid
                           && request.resource.data.size() < 35;
          allow update, delete: if false;
        }

        // ---- visits (ficha clínica del paciente) ----
        // Mismas restricciones que el paciente: inmutabilidad parcial y
        // revisiones inmutables. Cada visita es una entrada de la HC.
        match /visits/{visitId} {
          allow read:   if isOwner(clinicOwner(clinicId));
          allow create: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.size() < 30;
          allow update: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.size() < 30
                           && (!('createdBy' in resource.data)
                               || request.resource.data.createdBy == resource.data.createdBy)
                           && (!('createdAt' in resource.data)
                               || request.resource.data.createdAt == resource.data.createdAt)
                           && (!('revisionCount' in resource.data)
                               || request.resource.data.revisionCount == resource.data.revisionCount
                               || request.resource.data.revisionCount == resource.data.revisionCount + 1);
          // Hard delete prohibido. Usar soft delete.
          allow delete: if false;

          // ---- visit revisions (inmutables) ----
          match /revisions/{revId} {
            allow read:   if isOwner(clinicOwner(clinicId));
            allow create: if isOwner(clinicOwner(clinicId))
                             && request.resource.data.revisedBy == request.auth.uid
                             && request.resource.data.size() < 25;
            allow update, delete: if false;
          }
        }
      }

      // ---- appointments (turnos) ----
      match /appointments/{appointmentId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && isNonEmptyString(request.resource.data.patientId, 200)
                         && request.resource.data.size() < 30;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(clinicOwner(clinicId));
      }

      // ---- transactions (finanzas) ----
      match /transactions/{transactionId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && (request.resource.data.type == 'income' || request.resource.data.type == 'expense')
                         && request.resource.data.amount is number
                         && request.resource.data.amount > 0
                         && request.resource.data.size() < 30;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(clinicOwner(clinicId));
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

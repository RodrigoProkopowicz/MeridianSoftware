rules_version = '2';

// Meridian Software — Firestore Security Rules
//
// Collections:
//   users/{uid}               — perfil del usuario; las cuentas las crea un admin (callable createUser)
//   demoRequests/{id}         — pedido de prueba del formulario público (sin login); lo lee el admin
//   contactSubmissions/{id}   — created by anyone (anonymous contact form); read by admin only
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function payloadSizeOK() {
      // Limita por cantidad de campos (request.resource.size no existe en
      // Firestore rules — solo aplica a Storage). 30 campos es generoso para
      // los docs de esta app y previene payloads abusivos.
      return request.resource.data.size() < 30;
    }

    function hasOnlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isNonEmptyString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Super-admin global. Fuente de verdad ÚNICA: el custom claim
    // `auth.token.admin == true` (seteado por la callable `setAdminClaim` o por
    // el script grant-first-admin.mjs).
    //
    // Antes también se aceptaba `users/{uid}.role == 'admin'`; se unificó en el
    // claim porque el resto del sistema (callables + panel) solo confía en el
    // claim, así que un admin "role-only" quedaba a medias. ⚠️ ANTES de deployar
    // esta versión, correr `functions/scripts/migrate-admin-to-claim.mjs` para
    // otorgarle el claim a cualquier admin que hoy sea solo por role — si no,
    // pierde el acceso a Firestore. Bonus: sin el get() de antes, isAdmin() ya
    // no cuesta una lectura por chequeo.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---- users/{uid} ----
    // Profile is created and maintained by AuthenticationService.createOrUpdateUserProfile.
    // Admins can read/list all profiles for the admin panel.
    match /users/{uid} {
      allow read, list: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                       && hasOnlyFields(['email','displayName','photoURL','provider','createdAt','lastLoginAt'])
                       && payloadSizeOK();
      // Owner puede actualizar los campos originales sin tocar `role` ni `admin`
      // (los mantiene como estaban o ausentes). Admin puede modificar ambos.
      // `admin` lo escribe la callable createUser/setAdminClaim (Admin SDK) para
      // que el panel sepa quién es admin; el owner nunca puede cambiarlo.
      allow update: if (isOwner(uid)
                         && request.resource.data.keys().hasOnly(['email','displayName','photoURL','provider','createdAt','lastLoginAt','role','admin'])
                         && request.resource.data.get('role', null) == resource.data.get('role', null)
                         && request.resource.data.get('admin', null) == resource.data.get('admin', null)
                         && payloadSizeOK())
                      || (isAdmin()
                           && request.resource.data.keys().hasOnly(['email','displayName','photoURL','provider','createdAt','lastLoginAt','role','admin']));
      allow delete: if false;

      // ---- users/{uid}/demoAccess/{productId} ----
      // Demo grants for in-house products (stock-manager, medicus). Ya NO hay
      // auto-servicio: el visitante pide la prueba por el formulario público y
      // un admin la otorga desde el panel /admin (o la callable createUser).
      // Por eso create/update/delete son admin-only; el owner solo lee su estado.
      match /demoAccess/{productId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow list:   if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---- demoRequests/{id} ----
    // Pedidos de prueba del formulario PÚBLICO (sin login): cualquiera puede
    // crear uno con sus datos de contacto. App Check + la validación reCAPTCHA
    // server-side (validateDemoRecaptcha) filtran spam. El admin lee/lista y
    // puede actualizar solo status + adminNotes desde el panel.
    match /demoRequests/{id} {
      allow read, list: if isAdmin();
      allow create: if hasOnlyFields(['name','email','companyName','solutionType','message','status','recaptchaToken','createdAt'])
                       && isNonEmptyString(request.resource.data.name, 200)
                       && isNonEmptyString(request.resource.data.email, 200)
                       && isNonEmptyString(request.resource.data.solutionType, 100)
                       && request.resource.data.status == 'pending'
                       && payloadSizeOK();
      allow update: if isAdmin()
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNotes']);
      allow delete: if false;
    }

    // ---- contactSubmissions/{id} ----
    // El formulario de contacto pasó a usar mailto: del lado del cliente.
    // Ya no recibimos submissions nuevas; el admin puede leer el historial
    // que quedó, pero create/update/delete siguen cerrados.
    match /contactSubmissions/{id} {
      allow read, list: if isAdmin();
      allow write:      if false;
    }

    // ---- promotionalSubscriptions/{id} ----
    // Suscripciones del módulo /promo (PromotionalSection). El documento lo crea
    // y actualiza la Cloud Function `createPromotionalPreapproval` / el webhook
    // de Mercado Pago vía Admin SDK (bypassea estas reglas), por eso el cliente
    // NO puede crear: así el access token de MP y el estado de pago quedan solo
    // del lado del servidor. El admin lee todo y solo puede editar el estado del
    // trabajo y sus notas — nunca los campos de pago, que se sincronizan server-side.
    match /promotionalSubscriptions/{id} {
      allow read, list: if isAdmin();
      allow create:     if false;
      allow update:     if isAdmin()
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['workStatus', 'adminNotes', 'updatedAt']);
      // El admin puede borrar solo registros con error o cancelados (limpieza
      // de "logs"); nunca activas/pendientes/pausadas, que tienen una sub viva en MP.
      allow delete:     if isAdmin()
                           && resource.data.paymentStatus in ['error', 'cancelled'];
    }

    // ============================================================
    // Stock Manager — businesses + subcollections
    // Used by /stock-manager (separate Vite app, same Firebase project).
    // No usamos payloadSizeOK() porque depende de request.resource.size,
    // que no existe en Firestore rules (solo aplica a Storage). En su lugar
    // limitamos por número de campos con request.resource.data.size().
    // ============================================================

    function businessOwner(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId;
    }

    match /businesses/{businessId} {
      allow read:   if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if (isSignedIn()
                         && request.resource.data.ownerId == request.auth.uid
                         && request.resource.data.keys().hasOnly(['ownerId','name','currency','createdAt','updatedAt'])
                         && isNonEmptyString(request.resource.data.name, 120)
                         && isNonEmptyString(request.resource.data.currency, 8))
                      || isAdmin();
      allow update: if (isOwner(resource.data.ownerId)
                         && request.resource.data.ownerId == resource.data.ownerId
                         && request.resource.data.size() < 30)
                      || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      // ---- products ----
      match /products/{productId} {
        allow read:   if isOwner(businessOwner(businessId)) || isAdmin();
        allow create: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(businessOwner(businessId)) || isAdmin();
      }

      // ---- movements ----
      // Inmutables para el owner (solo create + read). Admin tiene bypass para
      // soporte: puede update/delete movements de comercios ajenos.
      match /movements/{movementId} {
        allow read:   if isOwner(businessOwner(businessId)) || isAdmin();
        allow create: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && request.resource.data.userId == request.auth.uid
                         && request.resource.data.size() < 30;
        allow update, delete: if isAdmin();
      }

      // ---- suppliers ----
      match /suppliers/{supplierId} {
        allow read:   if isOwner(businessOwner(businessId)) || isAdmin();
        allow create: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(businessOwner(businessId)) || isAdmin();
      }

      // ---- clients (destinatarios de facturas) ----
      match /clients/{clientId} {
        allow read:   if isOwner(businessOwner(businessId)) || isAdmin();
        allow create: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && isNonEmptyString(request.resource.data.name, 200)
                         && request.resource.data.size() < 30;
        allow update: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(businessOwner(businessId)) || isAdmin();
      }

      // ---- invoices (comprobantes de venta) ----
      // Las facturas son casi inmutables para el owner: solo se permite cambiar
      // status / cancelReason (número y totales son inmutables). Admin tiene
      // bypass total para soporte (incluido delete, que el owner no puede).
      match /invoices/{invoiceId} {
        allow read:   if isOwner(businessOwner(businessId)) || isAdmin();
        allow create: if (isOwner(businessOwner(businessId)) || isAdmin())
                         && request.resource.data.userId == request.auth.uid
                         && request.resource.data.size() < 40;
        allow update: if (isOwner(businessOwner(businessId))
                           && request.resource.data.size() < 40
                           // Inmutables: número, totales, items, fecha de emisión
                           && request.resource.data.number == resource.data.number
                           && request.resource.data.numberInt == resource.data.numberInt
                           && request.resource.data.total == resource.data.total
                           && request.resource.data.subtotal == resource.data.subtotal)
                        || isAdmin();
        allow delete: if isAdmin();
      }

      // ---- counters (numeración de comprobantes) ----
      match /counters/{counterId} {
        allow read:           if isOwner(businessOwner(businessId)) || isAdmin();
        allow create, update: if (isOwner(businessOwner(businessId)) || isAdmin())
                                  && request.resource.data.size() < 10;
        allow delete:         if isAdmin();
      }

      // ---- secrets (AFIP cert/key/tokens) ----
      // SOLO accesible vía Cloud Functions (admin SDK bypassea reglas).
      // El cliente NUNCA debe leer ni escribir esto directamente, ni siquiera
      // el super-admin global — usar las callables `saveAfipConfig`, etc.
      match /secrets/{secretId} {
        allow read, write: if false;
      }
    }

    // ============================================================
    // Medicus — clinics + subcolecciones
    // Usado por /medicus (Vite app aparte, mismo proyecto Firebase).
    // Modelo:
    //   clinics/{clinicId}                                   ← ownerId = uid
    //     └─ patients/{patientId}
    //         └─ visits/{visitId}                            ← ficha clínica
    //     └─ appointments/{appointmentId}                    ← turnos
    //     └─ transactions/{transactionId}                    ← finanzas
    // ============================================================

    function clinicOwner(clinicId) {
      return get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerId;
    }

    match /clinics/{clinicId} {
      allow read:   if isOwner(resource.data.ownerId);
      allow create: if isSignedIn()
                       && request.resource.data.ownerId == request.auth.uid
                       && isNonEmptyString(request.resource.data.name, 120)
                       && request.resource.data.size() < 30;
      allow update: if isOwner(resource.data.ownerId)
                       && request.resource.data.ownerId == resource.data.ownerId
                       && request.resource.data.size() < 30;
      allow delete: if isOwner(resource.data.ownerId);

      // ---- patients (HC — protegidos por Ley 26.529) ----
      // Inmutabilidad parcial:
      //  - Hard delete prohibido — usar soft delete vía update (deletedAt).
      //  - createdBy/createdAt no se pueden alterar una vez seteados (la app
      //    se los pone en create; docs viejos pueden no tenerlos y la regla
      //    deja que el migrador los rellene).
      //  - revisionCount monótono — solo se mantiene o crece de a uno.
      //  - El snapshot del estado previo se escribe en subcolección
      //    `revisions/{revId}` (inmutable, ver match más abajo).
      match /patients/{patientId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && isNonEmptyString(request.resource.data.firstName, 80)
                         && isNonEmptyString(request.resource.data.lastName, 80)
                         && request.resource.data.size() < 40;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 40
                         && (!('createdBy' in resource.data)
                             || request.resource.data.createdBy == resource.data.createdBy)
                         && (!('createdAt' in resource.data)
                             || request.resource.data.createdAt == resource.data.createdAt)
                         && (!('revisionCount' in resource.data)
                             || request.resource.data.revisionCount == resource.data.revisionCount
                             || request.resource.data.revisionCount == resource.data.revisionCount + 1);
        // Hard delete prohibido. Usar soft delete (update con deletedAt).
        allow delete: if false;

        // ---- patient revisions (inmutables) ----
        match /revisions/{revId} {
          allow read:   if isOwner(clinicOwner(clinicId));
          allow create: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.revisedBy == request.auth.uid
                           && request.resource.data.size() < 35;
          allow update, delete: if false;
        }

        // ---- visits (ficha clínica del paciente) ----
        // Mismas restricciones que el paciente: inmutabilidad parcial y
        // revisiones inmutables. Cada visita es una entrada de la HC.
        match /visits/{visitId} {
          allow read:   if isOwner(clinicOwner(clinicId));
          allow create: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.size() < 30;
          allow update: if isOwner(clinicOwner(clinicId))
                           && request.resource.data.size() < 30
                           && (!('createdBy' in resource.data)
                               || request.resource.data.createdBy == resource.data.createdBy)
                           && (!('createdAt' in resource.data)
                               || request.resource.data.createdAt == resource.data.createdAt)
                           && (!('revisionCount' in resource.data)
                               || request.resource.data.revisionCount == resource.data.revisionCount
                               || request.resource.data.revisionCount == resource.data.revisionCount + 1);
          // Hard delete prohibido. Usar soft delete.
          allow delete: if false;

          // ---- visit revisions (inmutables) ----
          match /revisions/{revId} {
            allow read:   if isOwner(clinicOwner(clinicId));
            allow create: if isOwner(clinicOwner(clinicId))
                             && request.resource.data.revisedBy == request.auth.uid
                             && request.resource.data.size() < 25;
            allow update, delete: if false;
          }
        }
      }

      // ---- appointments (turnos) ----
      match /appointments/{appointmentId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && isNonEmptyString(request.resource.data.patientId, 200)
                         && request.resource.data.size() < 30;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(clinicOwner(clinicId));
      }

      // ---- transactions (finanzas) ----
      match /transactions/{transactionId} {
        allow read:   if isOwner(clinicOwner(clinicId));
        allow create: if isOwner(clinicOwner(clinicId))
                         && (request.resource.data.type == 'income' || request.resource.data.type == 'expense')
                         && request.resource.data.amount is number
                         && request.resource.data.amount > 0
                         && request.resource.data.size() < 30;
        allow update: if isOwner(clinicOwner(clinicId))
                         && request.resource.data.size() < 30;
        allow delete: if isOwner(clinicOwner(clinicId));
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
